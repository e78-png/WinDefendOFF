<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>WinDefendOFF</AssemblyName>
    <RootNamespace>WinDefendOFF.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 版本資訊 -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>WinDefendOFF</Product>
    <Title>Microsoft Defender 開關</Title>
    <Description>自主控制 Microsoft Defender 的停用與恢復，無需重新啟動電腦。</Description>
    <Company>WinDefendOFF</Company>
    <Copyright>WinDefendOFF</Copyright>
    <ApplicationIcon>..\..\assets\WinDefendOFF.ico</ApplicationIcon>
    <NeutralLanguage>zh-TW</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDefendOFF.Core\WinDefendOFF.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\WinDefendOFF.ico" Link="WinDefendOFF.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
