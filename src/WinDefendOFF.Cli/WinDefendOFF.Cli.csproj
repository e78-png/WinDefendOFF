<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>WinDefendOFF.Cli</AssemblyName>
    <RootNamespace>WinDefendOFF.Cli</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>WinDefendOFF</Product>
    <Description>WinDefendOFF 命令列介面</Description>
    <Company>WinDefendOFF</Company>
    <ApplicationIcon>..\..\assets\WinDefendOFF.ico</ApplicationIcon>
    <NeutralLanguage>zh-TW</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDefendOFF.Core\WinDefendOFF.Core.csproj" />
  </ItemGroup>

</Project>
